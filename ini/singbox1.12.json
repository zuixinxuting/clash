{
  "log": {
    "level": "info",
    "timestamp": true
  },

  "dns": {
    "servers": [
      { "tag": "google", "address": "tls://8.8.8.8" },
      { "tag": "local", "address": "223.5.5.5", "detour": "DIRECT" }
    ],
    "rules": [
      { "outbound": "any", "server": "local" },
      { "rule_set": ["国外", "流媒体", "AI1", "AI2", "GitHub", "TikTok", "Telegram"], "server": "google" }
    ],
    "final": "google"
  },

 "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 7890,
      "sniff": true,
      "sniff_override_destination": true
    }
  ],

 "outbounds": [
    // 基础出站
    { "type": "direct", "tag": "DIRECT" },
    { "type": "block",  "tag": "REJECT" },

    // ==================== 1. 手动选择组 ====================
    {
      "type": "selector",
      "tag": "👽 AI1",
      "outbounds": [
        "DIRECT",
        "所有-自动",
        "港台日新韩-自动",
        "台日新韩-自动",
        "香港-自动",
        "台湾-自动",
        "日本-自动",
        "新加坡-自动",
        "韩国-自动",
        "美国-自动",
        "其他-自动",
        "REJECT"
      ],
      "default": "所有-自动"
    },
    {
      "type": "selector",
      "tag": "👽 AI2",
      "outbounds": [ /* 同上 */ ],
      "default": "所有-自动"
    },
    {
      "type": "selector",
      "tag": "📘 GitHub",
      "outbounds": [ /* 同上 */ ],
      "default": "所有-自动"
    },
    {
      "type": "selector",
      "tag": "👯‍♂️ TikTok",
      "outbounds": [ /* 同上 */ ],
      "default": "所有-自动"
    },
    {
      "type": "selector",
      "tag": "🙋 Telegram",
      "outbounds": [ /* 同上 */ ],
      "default": "所有-自动"
    },
    {
      "type": "selector",
      "tag": "📀 流媒体",
      "outbounds": [ /* 同上 */ ],
      "default": "所有-自动"
    },
    {
      "type": "selector",
      "tag": "🌍 国外",
      "outbounds": [ /* 同上 */ ],
      "default": "所有-自动"
    },
    {
      "type": "selector",
      "tag": "➡️ 国内",
      "outbounds": [ /* 同上 */ ],
      "default": "DIRECT"
    },

    // ==================== 2. 自动节点组 ====================
    {
      "type": "urltest",
      "tag": "所有-自动",
      "outbounds": [".*"],                     // 匹配所有节点（正则
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": "100ms"
    },
    {
      "type": "urltest",
      "tag": "港台日新韩-自动",
      "outbounds": [
        "广港","广台","广日","广新","广韩","广美",
        "香港","HK","Hong Kong","🇭🇰","HongKong",
        "台湾","TW","Tai Wan","🇹🇼","🇨🇳","TaiWan","Taiwan",
        "日本","JP","川日","东京","大阪","泉日","埼玉","沪日","深日","🇯🇵","Japan",
        "新加坡","SG","坡","狮城","🇸🇬","Singapore",
        "韩国","KR","首尔","春川","🇰🇷","Korea"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": "100ms"
    },
    {
      "type": "urltest",
      "tag": "台日新韩-自动",
      "outbounds": [
        "广台","广日","广新","广韩","广美",
        "台湾","TW","Tai Wan","🇹🇼","🇨🇳","TaiWan","Taiwan",
        "日本","JP","川日","东京","大阪","泉日","埼玉","沪日","深日","🇯🇵","Japan",
        "新加坡","SG","坡","狮城","🇸🇬","Singapore",
        "韩国","KR","首尔","春川","🇰🇷","Korea"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": "100ms"
    },
    {
      "type": "urltest",
      "tag": "香港-自动",
      "outbounds": ["广港","香港","HK","Hong Kong","🇭🇰","HongKong"],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": "100ms"
    },
    {
      "type": "urltest",
      "tag": "台湾-自动",
      "outbounds": ["广台","台湾","台灣","TW","Tai Wan","🇹🇼","🇨🇳","TaiWan","Taiwan"],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": "100ms"
    },
    {
      "type": "urltest",
      "tag": "日本-自动",
      "outbounds": ["广日","日本","JP","川日","东京","大阪","泉日","埼玉","沪日","深日","🇯🇵","Japan"],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": "100ms"
    },
    {
      "type": "urltest",
      "tag": "新加坡-自动",
      "outbounds": ["广新","新加坡","SG","坡","狮城","🇸🇬","Singapore"],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": "100ms"
    },
    {
      "type": "urltest",
      "tag": "韩国-自动",
      "outbounds": ["广韩","韩国","韓國","KR","首尔","春川","🇰🇷","Korea"],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": "100ms"
    },
    {
      "type": "urltest",
      "tag": "美国-自动",
      "outbounds": [
        "广美","美","US","纽约","波特兰","达拉斯","俄勒冈","凤凰城","费利蒙","硅谷",
        "拉斯维加斯","洛杉矶","圣何塞","圣克拉拉","西雅图","芝加哥","🇺🇸","United States"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": "100ms"
    },
    {
      "type": "urltest",
      "tag": "其他-自动",
      "outbounds": [
        "澳大利亚","澳洲","英国","加拿大","德国","法国","荷兰","印度","泰国",
        "越南","俄罗斯","巴西","土耳其","阿根廷","波兰","瑞典","瑞士","意大利"
      ],
      "url": "http://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": "100ms"
    }
  ],

  "route": {
    "auto_detect_interface": true,

    // 远程规则集（支持自动更新）
    "rule_set": [
      {
        "tag": "👽 AI1",
        "type": "remote",
        "format": "binary",   // Clash 规则是 binary sb 的规则集格式
        "url": "https://raw.githubusercontent.com/liandu2024/clash/refs/heads/main/list/AI.list",
        "download_detour": "DIRECT",
        "update_interval": "24h"
      },
      {
        "tag": "👽 AI2",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/liandu2024/clash/refs/heads/main/list/AI2.list",
        "download_detour": "DIRECT",
        "update_interval": "24h"
      },
      {
        "tag": "📘 GitHub",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/rule/Clash/GitHub/GitHub.list",
        "download_detour": "DIRECT"
      },
      {
        "tag": "👯‍♂️ TikTok",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/refs/heads/master/rule/Clash/TikTok/TikTok.list",
        "download_detour": "DIRECT"
      },
      {
        "tag": "🙋 Telegram",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Telegram/Telegram.list",
        "download_detour": "DIRECT"
      },
      {
        "tag": "流媒体",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/liandu2024/clash/refs/heads/main/list/YouTube.list",  // 你多个流媒体合并成一个也行，这里保留你原来的多个
        "download_detour": "DIRECT"
      },
      {
        "tag": "国外",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/liandu2024/clash/refs/heads/main/list/Proxy.list",
        "download_detour": "DIRECT"
      }
    ],

    "rules": [
      { "rule_set": "👽 AI1",            "outbound": "👽 AI1" },
      { "rule_set": "👽 AI2",            "outbound": "👽 AI2" },
      { "rule_set": "📘 GitHub",         "outbound": "📘 GitHub" },
      { "rule_set": "👯‍♂️ TikTok",       "outbound": "👯‍♂️ TikTok" },
      { "rule_set": "🙋 Telegram",        "outbound": "🙋 Telegram" },
      { "rule_set": ["流媒体"],          "outbound": "📀 流媒体" },   // 如果你想多个流媒体规则集合并，可继续加
      { "rule_set": "国外",              "outbound": "🌍 国外" },

      // 国内流量直连（FINAL）
      { "ip_is_private": true,           "outbound": "DIRECT" },
      { "network": "udp, "port": 5353,   "outbound": "DIRECT" },  // mDNS
      { "outbound": "DIRECT" }   // 最终默认国内直连
    ],

    "final": "➡️ 国内"
  },

  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "external_ui": "ui",
      "secret": ""
    }
  }
}



